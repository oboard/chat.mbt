import {
  "moonbitlang/core/json",
  "oboard/morm",
  "oboard/morm/engine",
  "oboard/morm/engine/sqlite3",
  "oboard/mocket",
  "moonbitlang/async",
  "moonbitlang/async/fs",
}

options(
  "is-main": true,
  "pre-build": [
    {
      "command": "$mod_dir/.mooncakes/oboard/morm/morm-gen $input -o $output && moonfmt -w $output",
      "input": "message.mbt",
      "output": "message.g.mbt",
    },
  ],
)
